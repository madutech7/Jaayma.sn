# URL de base de l'application (utile pour les liens WhatsApp et PWA)
APP_URL=http://localhost:3000

# Numéro de support WhatsApp (ex: +221771234567)
SUPPORT_WHATSAPP=+221770000000

# Numéro Wave pour recevoir les paiements d'abonnements Pro
BILLING_WAVE_NUMBER=+221770000000

# Liste des numéros de téléphones administrateurs séparés par des virgules
ADMIN_PHONES=+221771234567,+221781234567

# URL publique du bucket R2 pour servir les images produits directement (sans passer par le Worker)
# Ex: https://images.jaayma.sn  ou  https://pub-<hash>.r2.dev
# Laisser vide en dev local (utilise la route /api/images/ comme fallback)
NEXT_PUBLIC_R2_PUBLIC_URL=
