{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaayma",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaayma-db",
      "database_id": "d0a539b9-6352-4f16-8706-b221477c1ce3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jaayma-images"
    }
  ]
}
