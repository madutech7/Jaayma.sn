{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaayma-sn",
  "main": "worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "API_BASE_URL": "https://jaayma-sn.onrender.com",
    "NEXT_PUBLIC_API_URL": "https://jaayma-sn.onrender.com",
    "GA_MEASUREMENT_ID": "G-2SVKFRMHT3"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaayma-db",
      "database_id": "d0a539b9-6352-4f16-8706-b221477c1ce3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jaayma-images"
    }
  ]
}
